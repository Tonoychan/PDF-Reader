<Window x:Class="PdfReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:PdfReader.App.Reader"
        xmlns:lib="clr-namespace:PdfReader.App.Library"
        Title="PDF Reader"
        Width="1180" Height="860" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource UiFont}"
        AllowDrop="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <r:MultiplyConverter x:Key="Multiply" />
        <r:EmptyToVisibleConverter x:Key="EmptyToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />

        <!-- A book card in the library -->
        <DataTemplate x:Key="BookCardTemplate" DataType="{x:Type lib:LibraryCard}">
            <Button Width="196" Margin="8,0,8,18" Padding="0" Click="OnBookCardClick" Tag="{Binding}" Cursor="Hand" Focusable="False"
                    ToolTip="{Binding Path}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="OnCardOpenMenu" />
                        <MenuItem Header="Show in folder" Click="OnCardShowInFolderMenu" />
                        <Separator />
                        <MenuItem Header="Remove from Continue reading" Click="OnCardRemoveRecentMenu" />
                        <MenuItem Header="Remove from library" Click="OnCardRemoveLibraryMenu" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel>
                    <Border Height="236" CornerRadius="6" Background="White" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.12" />
                        </Border.Effect>
                        <Grid>
                            <TextBlock Text="{Binding Initial}" FontSize="54" FontWeight="SemiBold" Foreground="{DynamicResource ChromeBorderBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ChromeBorderBrush}" BorderThickness="0"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedInkBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LastRead}" FontSize="11.5" Foreground="{DynamicResource MutedInkBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Top bar: open, title, view, options, voice, speed ===== -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="True">
                <ToggleButton x:Name="LibraryButton" DockPanel.Dock="Left" Style="{StaticResource ToolToggle}" Margin="0,0,8,0"
                              Click="OnLibraryButtonClick" ToolTip="Your books (Ctrl+L)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F1;" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Library" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="OpenButton" DockPanel.Dock="Left" Style="{StaticResource AccentButton}"
                        Click="OnOpenClick" ToolTip="Open a PDF (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Open PDF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <ToggleButton x:Name="SidebarButton" DockPanel.Dock="Left" Style="{StaticResource ToolToggle}" Margin="8,0,0,0"
                              Click="OnSidebarButtonClick" ToolTip="Contents and search (Ctrl+F to search)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Contents" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Page | Text -->
                    <Border Background="{DynamicResource PaperBrush}" CornerRadius="10" Padding="3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="PageModeButton" Style="{StaticResource ToolToggle}" Padding="12,5"
                                          Click="OnPageModeClick" ToolTip="Show the real PDF pages">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C3;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Page" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="TextModeButton" Style="{StaticResource ToolToggle}" Padding="12,5"
                                          Click="OnTextModeClick" ToolTip="Show clean text with headings and pictures">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D2;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Text" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- Theme -->
                    <ToggleButton x:Name="ThemeButton" Style="{StaticResource ToolToggle}" Padding="9,6" Margin="0,0,6,0"
                                  ToolTip="Theme: light, sepia or dark">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE790;" FontSize="13" VerticalAlignment="Center" />
                    </ToggleButton>
                    <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ThemeButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" VerticalOffset="6"
                           IsOpen="{Binding IsChecked, ElementName=ThemeButton, Mode=TwoWay}">
                        <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14" Margin="0,0,10,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" />
                            </Border.Effect>
                            <StackPanel Width="250">
                                <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,8" />
                                <RadioButton x:Name="LightThemeRadio" GroupName="Theme" Content="Light" Margin="0,4" Checked="OnThemeChanged" />
                                <RadioButton x:Name="SepiaThemeRadio" GroupName="Theme" Content="Sepia" Margin="0,4" Checked="OnThemeChanged" />
                                <RadioButton x:Name="DarkThemeRadio" GroupName="Theme" Content="Dark" Margin="0,4" Checked="OnThemeChanged" />
                                <Rectangle Height="1" Fill="{DynamicResource ChromeBorderBrush}" Margin="0,10" />
                                <CheckBox x:Name="MatchPagesCheck" Margin="0,4" Checked="OnMatchPagesChanged" Unchecked="OnMatchPagesChanged">
                                    <TextBlock TextWrapping="Wrap" Text="Recolour the PDF pages to match (sepia paper, dark pages)" />
                                </CheckBox>
                                <TextBlock Text="In dark pages, pictures can look unusual. Turn this off to see the original colours."
                                           Style="{StaticResource ChromeText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Reading options -->
                    <ToggleButton x:Name="OptionsButton" Style="{StaticResource ToolToggle}" Margin="0,0,10,0"
                                  ToolTip="Choose what is read aloud">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="Reading options" VerticalAlignment="Center" />
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="9" Margin="7,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" VerticalOffset="6"
                           IsOpen="{Binding IsChecked, ElementName=OptionsButton, Mode=TwoWay}">
                        <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14" Margin="0,0,10,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" />
                            </Border.Effect>
                            <StackPanel Width="280">
                                <TextBlock Text="Don't read aloud" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,8" />
                                <CheckBox x:Name="SkipHeadersCheck" Content="Page headers, footers &amp; page numbers" Margin="0,4" Checked="OnReadingOptionChanged" Unchecked="OnReadingOptionChanged" />
                                <CheckBox x:Name="SkipFootnotesCheck" Content="Footnotes" Margin="0,4" Checked="OnReadingOptionChanged" Unchecked="OnReadingOptionChanged" />
                                <CheckBox x:Name="SkipTocCheck" Content="Table of contents pages" Margin="0,4" Checked="OnReadingOptionChanged" Unchecked="OnReadingOptionChanged" />
                                <CheckBox x:Name="SkipCaptionsCheck" Content="Picture captions" Margin="0,4" Checked="OnReadingOptionChanged" Unchecked="OnReadingOptionChanged" />
                                <Rectangle Height="1" Fill="{DynamicResource ChromeBorderBrush}" Margin="0,10" />
                                <CheckBox x:Name="PauseHeadingsCheck" Content="Pause briefly around headings" Margin="0,4" Checked="OnReadingOptionChanged" Unchecked="OnReadingOptionChanged" />
                                <Rectangle Height="1" Fill="{DynamicResource ChromeBorderBrush}" Margin="0,10" />
                                <TextBlock Text="Pronunciation" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6" />
                                <CheckBox x:Name="SmartPronunciationCheck" Margin="0,4" Checked="OnPronunciationChanged" Unchecked="OnPronunciationChanged">
                                    <TextBlock TextWrapping="Wrap" Text="Read abbreviations, code names (AudioSource), file types (.wav) and links naturally" />
                                </CheckBox>
                                <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="-8,4,0,0" Click="OnWordListClick"
                                        Content="My word list…" ToolTip="Tell it how to say particular words" />
                                <TextBlock Text="Text inside pictures is never read." Style="{StaticResource ChromeText}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <TextBlock Style="{StaticResource ChromeText}" Text="Voice" Margin="4,0,8,0" />
                    <ComboBox x:Name="VoiceBox" Width="230" VerticalAlignment="Center" Padding="8,5"
                              SelectionChanged="OnVoiceChanged" ToolTip="Natural voices and Windows voices installed on this PC" />
                    <Button x:Name="VoicesButton" Style="{StaticResource ToolButton}" Padding="9,6" Margin="4,0,0,0" Click="OnVoicesClick"
                            ToolTip="Get natural voices">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="13" VerticalAlignment="Center" />
                    </Button>
                    <TextBlock Style="{StaticResource ChromeText}" Text="Speed" Margin="16,0,8,0" />
                    <Slider x:Name="SpeedSlider" Width="110" VerticalAlignment="Center"
                            Minimum="0.5" Maximum="2.5" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                            Focusable="False" ValueChanged="OnSpeedChanged" />
                    <TextBlock x:Name="SpeedLabel" Style="{StaticResource ChromeText}" Text="1.0×" Width="40"
                               Margin="8,0,0,0" Foreground="{DynamicResource InkBrush}" />
                </StackPanel>

                <StackPanel Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BookTitle" Text="No book open" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="BookInfo" Style="{StaticResource ChromeText}" FontSize="12" Text="Open a PDF to start" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar: Contents | Search ===== -->
            <Border x:Name="Sidebar" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,10,10,6">
                        <Border Background="{DynamicResource PaperBrush}" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ContentsTab" Style="{StaticResource ToolToggle}" Padding="14,5" Content="Contents" Click="OnContentsTabClick" />
                                <ToggleButton x:Name="SearchTab" Style="{StaticResource ToolToggle}" Padding="14,5" Content="Search" Click="OnSearchTabClick" />
                                <ToggleButton x:Name="BookmarksTab" Style="{StaticResource ToolToggle}" Padding="14,5" Content="Bookmarks" Click="OnBookmarksTabClick" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <Grid>
                        <!-- Contents -->
                        <Grid x:Name="ContentsPanel">
                            <ListBox x:Name="ContentsList" BorderThickness="0" Background="Transparent" Padding="0,2,0,10"
                                     ItemContainerStyle="{StaticResource SidebarListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     PreviewMouseLeftButtonUp="OnContentsClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type r:OutlineItem}">
                                        <DockPanel Margin="{Binding Indent}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PageLabel}" Margin="10,0,0,0" FontSize="12"
                                                       Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Top" />
                                            <TextBlock x:Name="Title" Text="{Binding Title}" TextWrapping="Wrap" FontSize="13.5"
                                                       Foreground="{DynamicResource InkBrush}" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsTopLevel}" Value="True">
                                                <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ContentsEmpty" Visibility="Collapsed" Margin="20" TextWrapping="Wrap"
                                       Style="{StaticResource ChromeText}" VerticalAlignment="Top"
                                       Text="This book has no contents list or headings to show." />
                        </Grid>

                        <!-- Bookmarks & notes -->
                        <DockPanel x:Name="BookmarksPanel" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,4,12,8">
                                <Button Style="{StaticResource AccentButton}" Padding="12,6" Click="OnAddBookmarkClick" ToolTip="Bookmark the word being read, or the cursor (Ctrl+D)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add bookmark" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExportNotesButton" Style="{StaticResource ToolButton}" Padding="12,6" Margin="6,0,0,0" Content="Export…"
                                        Click="OnExportNotesClick" ToolTip="Save all bookmarks and notes as a Markdown file" />
                            </StackPanel>
                            <TextBlock x:Name="BookmarksEmpty" DockPanel.Dock="Top" Margin="16,4,16,0" TextWrapping="Wrap" Style="{StaticResource ChromeText}" FontSize="12.5"
                                       Text="No bookmarks yet. Use Add bookmark (Ctrl+D), or right-click a word and choose Add bookmark or Add note." />
                            <ListBox x:Name="BookmarksList" BorderThickness="0" Background="Transparent" Padding="0,0,0,10"
                                     ItemContainerStyle="{StaticResource SidebarListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonUp="OnBookmarkClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type lib:BookmarkItem}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="6,2" FontFamily="{StaticResource IconFont}"
                                                        FontSize="10" Content="&#xE711;" ToolTip="Delete bookmark" Click="OnDeleteBookmarkClick" Tag="{Binding}" />
                                                <TextBlock Text="{Binding PageLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource MutedInkBrush}" Margin="0,2,0,6" />
                                            <Grid>
                                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" FontSize="13"
                                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="30" Padding="6,4" Tag="{Binding}" />
                                                <TextBlock Text="Add a note…" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource ChromeText}" FontSize="12.5">
                                                    <TextBlock.Visibility>
                                                        <Binding Path="Note" Converter="{StaticResource EmptyToVisible}" />
                                                    </TextBlock.Visibility>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Search -->
                        <DockPanel x:Name="SearchPanel" Visibility="Collapsed">
                            <Grid DockPanel.Dock="Top" Margin="12,4,12,6">
                                <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" TextChanged="OnSearchTextChanged"
                                         PreviewKeyDown="OnSearchKeyDown" />
                                <TextBlock x:Name="SearchHint" Text="Search this book…" IsHitTestVisible="False" Margin="11,0,0,0"
                                           VerticalAlignment="Center" Style="{StaticResource ChromeText}" />
                            </Grid>
                            <TextBlock x:Name="SearchStatus" DockPanel.Dock="Top" Margin="16,0,16,6" Style="{StaticResource ChromeText}" FontSize="12" />
                            <ListBox x:Name="SearchResults" BorderThickness="0" Background="Transparent" Padding="0,0,0,10"
                                     ItemContainerStyle="{StaticResource SidebarListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     PreviewMouseLeftButtonUp="OnSearchResultClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type r:SearchItem}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PageLabel}" FontSize="11.5" Foreground="{DynamicResource MutedInkBrush}" Margin="0,0,0,2" />
                                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkBrush}">
                                                <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Match, Mode=OneWay}" FontWeight="Bold"
                                                     Background="{DynamicResource ReadingWordBrush}" /><Run Text="{Binding After, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
            <!-- ===== Page view (the real PDF pages) ===== -->
            <r:PagesView x:Name="PagesViewControl" Visibility="Collapsed" Background="{DynamicResource PageBackdropBrush}" />

            <!-- ===== Text view (clean text, headings, pictures) ===== -->
            <ListBox x:Name="ReaderList" Visibility="Collapsed"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     FontFamily="{StaticResource ReadingFont}" FontSize="19" Foreground="{DynamicResource InkBrush}"
                     Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type r:ParagraphItem}">
                        <Border x:Name="Bd" MaxWidth="840" Margin="24,0" Padding="20,8" CornerRadius="10" Background="Transparent">
                            <r:WordTextBlock x:Name="Text" Item="{Binding}" />
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Heading">
                                <Setter TargetName="Text" Property="FontFamily" Value="{StaticResource UiFont}" />
                                <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Text" Property="FontSize"
                                        Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Multiply}, ConverterParameter=1.3}" />
                                <Setter TargetName="Bd" Property="Margin" Value="24,18,24,2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Footnote">
                                <Setter TargetName="Text" Property="FontSize"
                                        Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Multiply}, ConverterParameter=0.78}" />
                                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Caption">
                                <Setter TargetName="Text" Property="FontSize"
                                        Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Multiply}, ConverterParameter=0.8}" />
                                <Setter TargetName="Text" Property="FontStyle" Value="Italic" />
                                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="TableOfContents">
                                <Setter TargetName="Text" Property="FontSize"
                                        Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Multiply}, ConverterParameter=0.85}" />
                                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
                                <Setter TargetName="Bd" Property="Padding" Value="20,2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasBookmark}" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveParagraphBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type r:ImageItem}">
                        <Border MaxWidth="840" Margin="24,10" Padding="20,0">
                            <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Center">
                                <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Background="White"
                                        BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1">
                                    <Image Source="{Binding Bitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </Viewbox>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type r:PageHeaderItem}">
                        <Grid MaxWidth="840" Margin="44,26,44,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Height="1" Fill="{DynamicResource ChromeBorderBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="14,0" FontFamily="{StaticResource UiFont}"
                                       FontSize="12" Foreground="{DynamicResource MutedInkBrush}" />
                            <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource ChromeBorderBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE736;" FontSize="54" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedInkBrush}" Margin="0,0,0,18" />
                <TextBlock Text="Open a PDF to start reading" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text="or drag a PDF file onto this window" FontSize="14" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedInkBrush}" Margin="0,6,0,22" />
                <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Padding="20,10" Click="OnOpenClick">
                    <TextBlock Text="Browse…" FontSize="14" />
                </Button>
            </StackPanel>

            <!-- Loading -->
            <Grid x:Name="LoadingPanel" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
                <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Width="300">
                        <TextBlock x:Name="LoadingText" Text="Reading pages…" FontSize="15" Foreground="{DynamicResource InkBrush}" />
                        <ProgressBar x:Name="LoadingProgress" Height="6" Margin="0,14,0,16" Minimum="0" Maximum="1"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource HoverBrush}" BorderThickness="0" />
                        <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Right" Content="Cancel" Click="OnCancelLoadClick" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Shown when you scroll away while it reads -->
            <Button x:Name="BackToReadingButton" Visibility="Collapsed" Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,34,22" Padding="16,9"
                    Click="OnBackToReadingClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74B;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Back to reading position" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            </Grid>
        </Grid>

        <!-- ===== Library (home screen) ===== -->
        <Grid x:Name="LibraryPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource PaperBrush}">
            <ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="44,28,44,44" MaxWidth="1500">
                    <DockPanel Margin="8,0,8,18">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="240" Margin="0,0,10,0">
                                <TextBox x:Name="LibraryFilter" Style="{StaticResource FieldBox}" TextChanged="OnLibraryFilterChanged" />
                                <TextBlock x:Name="LibraryFilterHint" Text="Find a book…" IsHitTestVisible="False" Margin="11,0,0,0"
                                           VerticalAlignment="Center" Style="{StaticResource ChromeText}" />
                            </Grid>
                            <Button x:Name="LibraryBackButton" Style="{StaticResource AccentButton}" Padding="14,7" Click="OnLibraryBackClick" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LibraryBackText" Text="Back to book" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Library" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Hero when there's nothing yet -->
                    <Border x:Name="LibraryHero" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="34,30" Margin="8,0,8,24">
                        <StackPanel>
                            <TextBlock Text="Open a PDF to start reading" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                            <TextBlock Text="Books you open appear here with your progress. You can also pick a books folder and every PDF in it is listed below."
                                       TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource MutedInkBrush}" Margin="0,6,0,18" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Padding="18,9" Click="OnOpenClick" Content="Open a PDF…" />
                                <Button Style="{StaticResource ToolButton}" Padding="16,9" Margin="8,0,0,0" Click="OnChooseFolderClick" Content="Choose books folder…" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="RecentHeader" Text="Continue reading" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="8,0,8,10" />
                    <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource BookCardTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <DockPanel x:Name="FolderHeader" Margin="8,26,8,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="RefreshFolderButton" Style="{StaticResource ToolButton}" Padding="10,5" Click="OnRefreshFolderClick" ToolTip="Look for new PDFs">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Padding="10,5" Margin="4,0,0,0" Click="OnChooseFolderClick" Content="Change folder…" />
                            <Button x:Name="ForgetFolderButton" Style="{StaticResource ToolButton}" Padding="10,5" Margin="4,0,0,0" Click="OnForgetFolderClick"
                                    Content="Stop watching" ToolTip="Stop listing this folder's books" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Books folder" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                            <TextBlock x:Name="FolderPathText" Style="{StaticResource ChromeText}" Margin="12,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="FolderStatus" Style="{StaticResource ChromeText}" Margin="8,0,8,10" />
                    <ItemsControl x:Name="FolderList" ItemTemplate="{StaticResource BookCardTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Transport bar ===== -->
        <Border Grid.Row="2" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource ChromeText}" TextTrimming="CharacterEllipsis"
                           Margin="0,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevButton" Style="{StaticResource TransportButton}" Content="&#xE892;"
                            Click="OnPrevClick" ToolTip="Previous paragraph (Ctrl+Left)" />
                    <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Content="&#xE768;" Margin="10,0"
                            Click="OnPlayClick" ToolTip="Play (Space)" />
                    <Button x:Name="StopButton" Style="{StaticResource TransportButton}" Content="&#xE71A;"
                            Click="OnStopClick" ToolTip="Stop (Esc)" Margin="0,0,10,0" />
                    <Button x:Name="NextButton" Style="{StaticResource TransportButton}" Content="&#xE893;"
                            Click="OnNextClick" ToolTip="Next paragraph (Ctrl+Right)" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BookmarkButton" Style="{StaticResource ToolButton}" Click="OnAddBookmarkClick" Margin="0,0,2,0" Padding="9,7"
                            ToolTip="Add a bookmark here (Ctrl+D)">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A4;" FontSize="14"
                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    </Button>
                    <Button x:Name="FromCursorButton" Style="{StaticResource ToolButton}" Click="OnFromCursorClick"
                            ToolTip="Start reading from the word you clicked (or double-click a word)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="11" Margin="0,0,7,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Read from cursor" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Go to page (Ctrl+G)">
                        <TextBlock Text="Page" Style="{StaticResource ChromeText}" Margin="0,0,6,0" />
                        <TextBox x:Name="PageBox" Style="{StaticResource FieldBox}" Width="52" Padding="6,3" TextAlignment="Center"
                                 PreviewKeyDown="OnPageBoxKeyDown" GotKeyboardFocus="OnPageBoxFocus" LostKeyboardFocus="OnPageBoxLostFocus" />
                        <TextBlock x:Name="PageTotal" Style="{StaticResource ChromeText}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="ZoomLabel" Style="{StaticResource ChromeText}" Margin="10,0,0,0" ToolTip="Ctrl + mouse wheel to zoom" />
                    <CheckBox x:Name="FollowCheck" Content="Follow reading" IsChecked="True" Focusable="False"
                              VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13" Foreground="{DynamicResource InkBrush}"
                              Checked="OnFollowChanged" Unchecked="OnFollowChanged"
                              ToolTip="Keep the word being read in view" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
